<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>Cike.Templates</PackageId>
		<PackageVersion>1.0.1</PackageVersion>
		<Title>Cike Templates</Title>
		<Authors>Cike Framework</Authors>
		<Description>Templates to use when creating an application for Cike Framework.</Description>
		<PackageTags>dotnet-new;templates;Cike</PackageTags>
		<PackageProjectUrl>https://github.com/CikeLemon/Cike.Framework</PackageProjectUrl>

		<PackageType>Template</PackageType>
		<TargetFramework>netstandard2.0</TargetFramework>
		<IncludeContentInPack>true</IncludeContentInPack>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<ContentTargetFolders>content</ContentTargetFolders>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<NoDefaultExcludes>true</NoDefaultExcludes>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Slns\**\*" Exclude="Slns\**\bin\**;Slns\**\obj\**" />
		<Compile Remove="**\*" />
	</ItemGroup>

</Project>
