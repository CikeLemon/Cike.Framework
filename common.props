<Project>
	<PropertyGroup>
		<Authors>Lemon.Li</Authors>
		<Company>Lemon.Li</Company>
		<PackageProjectUrl>https://github.com/CikeLemon/Cike.Framework</PackageProjectUrl>
		<PackageIconUrl>https://github.com/CikeLemon/Cike.Framework/blob/main/logo.png</PackageIconUrl>
		<RepositoryUrl>https://github.com/CikeLemon/Cike.Framework</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
		<!-- 优先打包模块自己的 README.md（未写则回退到仓库根 README.md） -->
		<None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')"/>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="!Exists('README.md') and Exists('..\..\README.md')"/>
	</ItemGroup>
</Project>